{
  "name": "@ohnejs/next",
  "version": "0.0.1",
  "description": "Renders the pages of an ohne CMS in Next.js: redirects, 404s, metadata and the live preview.",
  "homepage": "https://ohne.dev/docs/cms/frameworks#next",
  "license": "MIT",
  "author": "Muris Ceman <muris@ohne.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohnejs/next.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "client.d.ts",
    "server.js"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "react-server": "./index.js",
      "default": "./server.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "node --test --test-concurrency=1 --import ./tests/resolve-next.ts \"tests/*.test.ts\"",
    "typecheck": "tsc && tsc -p tsconfig.js.json && pnpm --filter fixture exec next typegen && pnpm --filter fixture exec tsc --noEmit"
  },
  "devDependencies": {
    "@ohnejs/client": "0.2.0",
    "@ohnejs/cms": "0.1.0",
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.2",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ohnejs/client": ">=0.2.0 <0.3.0-0",
    "@types/react": ">=19.0.0 <20.0.0-0",
    "next": ">=16.0.0 <17.0.0-0",
    "react": ">=19.0.0 <20.0.0-0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.5.1"
}
